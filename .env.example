# Copy this file to .env and set a real password before deploying.
DASHBOARD_PASSWORD=changeme
PORT=3001

# Optional: sends the automated confirmation email (with a provisional
# .ics save-the-date attached) after each invitation request. Leave unset
# to skip sending — submissions still work without it.
# Get an API key at https://resend.com, and verify a sending domain there
# so RESEND_FROM_EMAIL can be an address on it (e.g. "THE SALON <salon@your-verified-domain.com>").
RESEND_API_KEY=
RESEND_FROM_EMAIL=
